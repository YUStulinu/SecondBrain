# ---- Answering (required for Q&A; search works without it) ----
ANTHROPIC_API_KEY=put_your_anthropic_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Embeddings ----
# local  : runs on your machine, free and private. Needs `npm run setup:local` once.
# openai : uses OpenAI's embedding API. Needs OPENAI_API_KEY. Your text leaves your machine.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/multilingual-e5-small
OPENAI_API_KEY=

PORT=3007
# Your notes are private; the server listens only on this machine by default.
HOST=127.0.0.1
